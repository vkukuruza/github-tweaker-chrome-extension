{
  "manifest_version": 3,
  "name": "GitHub Tweaker",
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "version": "2.3.0",
  "description": "Shows source/target branch names, colorized branches, and one-click commit previews on GitHub's Pull Requests list.",
  "icons": {
    "16": "icons/github-mark.png",
    "32": "icons/github-mark.png",
    "48": "icons/github-mark.png",
    "128": "icons/github-mark.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "permissions": ["tabs", "storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "run_at": "document_idle",
      "js": ["colorPicker.js", "contentScript.js"]
    }
  ]
}
